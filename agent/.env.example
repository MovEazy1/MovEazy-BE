# Copy to be/agent/.env — server-side only (never expose to browser).

# Supabase (Settings → API Keys → service_role or secret key)
# SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=

# Firestore sync only (scripts/sync_firestore.py):
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/serviceAccount.json
# FIREBASE_PROJECT_ID=moveasy-30eed

# Production hardening (local dev can omit):
# FLAT_AGENT_API_KEY=
# FLAT_AGENT_CORS=https://moveeazy.in,https://www.moveeazy.in
